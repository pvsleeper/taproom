# Copy this to .env (gitignored) next to docker-compose.yml and fill in real values.

# --- Omada Controller ---
OMADA_BASE_URL=https://10.0.1.10:8043
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_SITE_NAME=Default
# true if the controller uses a self-signed certificate.
OMADA_ALLOW_INVALID_CERTIFICATE=true

# --- OPNsense ---
OPNSENSE_BASE_URL=https://10.0.1.1
# The API key's user needs these privileges besides the read ones: "Interfaces: Diagnostics: DNS Lookup" (reverse
# lookups are made by the router so they're logged as localhost, not as this machine).
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# true if the router uses a self-signed certificate.
OPNSENSE_ALLOW_INVALID_CERTIFICATE=true
OPNSENSE_LAN_INTERFACE=lan
OPNSENSE_WAN_INTERFACE=wan

# --- Home location (for the connection map's home marker) ---
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_LABEL=Home
