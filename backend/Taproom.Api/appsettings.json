{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Taproom": {
    "PollIntervalSeconds": 30,
    "Omada": {
      "BaseUrl": "https://omada.example.invalid",
      "ClientId": "",
      "ClientSecret": "",
      "SiteName": "Default",
      "AllowInvalidCertificate": true
    },
    "Opnsense": {
      "BaseUrl": "https://opnsense.example.invalid",
      "ApiKey": "",
      "ApiSecret": "",
      "AllowInvalidCertificate": true,
      "DhcpProvider": "Dnsmasq"
    }
  }
}
